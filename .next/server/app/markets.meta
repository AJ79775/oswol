{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/markets/layout,_N_T_/(app)/markets/page,_N_T_/markets"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/markets/__PAGE__",
    "/!KGFwcCk/markets",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}