# /etc/oswol-video/env  — Oswol Daily Brief video agent settings
# (install.sh copies this file there; edit it, then: sudo systemctl start oswol-video)

# ---------- Where today's newsletter comes from ----------
# oswol_api = POST to the Oswol app (src/app/api/ai/newsletter/route.ts)
# url       = any page or JSON endpoint with the day's newsletter (HTML is cleaned up automatically)
# rss       = newest item of an RSS/Atom feed
# file      = a local .json/.md/.html/.txt file (NEWSLETTER_FILE)
# imap      = newest email from NEWSLETTER_IMAP_FROM
NEWSLETTER_SOURCE=oswol_api
NEWSLETTER_URL=http://127.0.0.1:3000/api/ai/newsletter
# NEWSLETTER_FILE=/var/lib/oswol-video/inbox/today.md
# NEWSLETTER_HEADERS=Cookie: session=...; X-Custom: value
# OSWOL_API_KEY=
# NEWSLETTER_IMAP_HOST=imap.gmail.com
# NEWSLETTER_IMAP_USER=
# NEWSLETTER_IMAP_PASSWORD=
# NEWSLETTER_IMAP_FROM=newsletter@oswol.com
# Only accept a newsletter dated today, and wait up to N minutes for it to appear:
NEWSLETTER_REQUIRE_TODAY=0
NEWSLETTER_WAIT_MINUTES=0

# ---------- LLM: FreeLLMAPI on this VPS ----------
# Unified key from the FreeLLMAPI dashboard (Keys page header).
LLM_BASE_URL=http://127.0.0.1:3001/v1
LLM_API_KEY=freellmapi-REPLACE-ME
# Tried in order. "auto:smart" lets the FreeLLMAPI router pick its strongest healthy free model.
LLM_MODELS=auto:smart,auto
LLM_TEMPERATURE=0.4
# Optional NVIDIA Switchyard in front of FreeLLMAPI (see deploy/switchyard/routes.toml):
# LLM_BASE_URL=http://127.0.0.1:4000/v1
# LLM_MODELS=switchyard/oswol,auto:smart

# ---------- Script ----------
TARGET_MINUTES=5
BRIEF_TIMEZONE=Asia/Riyadh
BRIEF_LANGUAGE=en

# ---------- Narrator: one fixed voice every day ----------
# kokoro (default, local, free, no internet) | voicestudio | edge | openai
TTS_ENGINE=kokoro
# Kokoro voices: af_heart (warm female, best quality), af_bella, am_michael, am_fenrir, bf_emma, bm_george ...
TTS_VOICE=af_heart
TTS_SPEED=0.96
KOKORO_MODEL_DIR=/opt/oswol-video/models
# Leave empty so the voice never changes. If set, a failure re-voices the WHOLE video with this engine.
TTS_FALLBACK=
# EDGE_VOICE=en-US-AndrewNeural
# VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_ENGINE=kittentts
# VOICESTUDIO_API_KEY=
# VOICESTUDIO_SEED=42

# ---------- Memory & live data ----------
MEMORY_DAYS=5
# OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_API_KEY=
# Live crypto / FX snapshot (CoinGecko, Frankfurter) for assets the newsletter mentions:
ENRICH_LIVE_DATA=1
# FRED_API_KEY=

# ---------- Video ----------
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=20
BURN_CAPTIONS=1
# Parallel scene renders (each uses ~1 CPU core + ~300 MB RAM). Leave a core for your other services.
RENDER_WORKERS=2

# ---------- Storage & access ----------
WORK_DIR=/var/lib/oswol-video/runs
VIDEO_ROOT=/var/www/oswol-videos
# URL prefix the gallery uses. "/videos" for https://oswol.com/videos/, empty for a subdomain root.
PUBLIC_BASE_URL=/videos
# Delete videos older than N days (0 = keep forever). ~25-40 MB per 5-minute video.
KEEP_DAYS=0
# POSTed as JSON after each publish (Slack/Discord/Make/n8n webhook):
# NOTIFY_WEBHOOK_URL=
# PHOTOCRAFT_BIN=/usr/bin/photocraft-cli
